---
import BaseLayout from '../layouts/BaseLayout.astro';
import pages from '../data/service-pages.json';
import site from '../data/site.json';

export function getStaticPaths() {
  return pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
const paragraphs = page.body.split('\n\n');
const serviceLabel = page.slug.includes('nettoyage') ? 'Nettoyage de gouttières' : page.slug.includes('pare-feuilles') ? 'Pare-feuilles' : 'Installation sans joints';
---
<BaseLayout title={page.title} description={page.metaDescription} canonicalPath={`/${page.slug}/`}>
  <section class="service-hero trade-service-hero">
    <div class="container service-hero-grid">
      <div>
        <p class="eyebrow">{serviceLabel} — Québec, Lévis et Rive-Sud</p>
        <h1>{page.h1}</h1>
        <p class="lead">{page.intro}</p>
        <div class="hero-actions">
          <a class="btn" href={`mailto:${site.email}?subject=${encodeURIComponent(page.cta)}`}>{page.cta}</a>
          <a class="btn secondary" href="/#services">Tous les services</a>
        </div>
      </div>
      <div class="service-hero-visual gutter-service-visual" aria-label="Illustration du service de gouttières">
        <div class="service-roofline">
          <span class="service-badge">{serviceLabel}</span>
          <div class="roof-strip"></div>
          <div class="service-gutter"><i></i></div>
          <div class="service-downspout"></div>
          <div class="service-tools"><span>Échelle</span><b>Inspection</b></div>
        </div>
        <div class="visual-metrics">
          <div class="metric-card"><small>Climat</small><strong>Gel</strong><span>dégel répété</span></div>
          <div class="metric-card"><small>Système</small><strong>Sans</strong><span>joints visibles</span></div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container service-content-grid">
      <article class="service-copy card">
        {paragraphs.map((paragraph, index) => (
          <p class={index === 0 ? 'opening-paragraph' : undefined}>{paragraph}</p>
        ))}
      </article>
      <aside class="sticky-quote-card trade-quote-card">
        <p class="eyebrow">Besoin concret</p>
        <h2>Nettoyer, remplacer ou protéger vos gouttières</h2>
        <ul class="feature-list">
          <li>Évaluation du drainage et des zones à risque</li>
          <li>Recommandations adaptées au climat de Québec</li>
          <li>Options de gouttières sans joints, nettoyage et pare-feuilles</li>
          <li>Travail sécuritaire autour de la toiture et des descentes</li>
          <li>Soumission gratuite dans la grande région de Québec</li>
        </ul>
        <a class="btn" href={`mailto:${site.email}?subject=${encodeURIComponent(page.cta)}`}>{page.cta}</a>
      </aside>
    </div>
  </section>

  <section class="dark">
    <div class="container">
      <div class="cta-band">
        <div>
          <p class="eyebrow">Soumission gratuite</p>
          <h2>Parlez-nous de votre propriété à Québec ou Lévis</h2>
          <p>Recevez une recommandation claire pour protéger votre toiture, vos fondations et votre maison contre l’eau, la neige et la glace.</p>
        </div>
        <a class="btn" href={`mailto:${site.email}?subject=${encodeURIComponent(page.cta)}`}>{page.cta}</a>
      </div>
    </div>
  </section>

  <style>
    .trade-service-hero { padding-top: clamp(58px, 7vw, 100px); background: linear-gradient(180deg, #faf7f0, #fff); }
    .service-hero-grid { display: grid; grid-template-columns: minmax(0, 1.04fr) minmax(340px, .82fr); gap: clamp(32px, 7vw, 78px); align-items: center; }
    .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 30px; }
    .gutter-service-visual { min-height: 410px; padding: 22px; overflow: hidden; background: linear-gradient(160deg, #eee5d8, #ffffff 52%, #e9f0ec); border: 1px solid #d8cfc0; border-radius: 22px; box-shadow: var(--shadow-premium); }
    .service-roofline { position: relative; min-height: 268px; border-radius: 16px; overflow: hidden; background: linear-gradient(180deg, #d9edf8 0 48%, #efe1cf 48% 100%); margin-bottom: 16px; }
    .service-badge { position: absolute; left: 18px; top: 18px; z-index: 5; padding: 8px 12px; border-radius: 999px; background: white; color: var(--roof-charcoal); font-weight: 900; font-size: .85rem; box-shadow: var(--shadow-soft); }
    .roof-strip { position: absolute; left: 18px; right: 18px; top: 104px; height: 74px; background: linear-gradient(135deg, var(--roof-charcoal), var(--roof-deep)); clip-path: polygon(0 70%, 55% 0, 100% 52%, 100% 100%, 0 100%); }
    .service-gutter { position: absolute; left: 38px; right: 44px; top: 174px; height: 22px; border-radius: 0 0 14px 14px; background: linear-gradient(180deg, #f7f8f7, var(--aluminum)); border: 1px solid var(--aluminum-dark); box-shadow: 0 13px 22px rgba(18,26,32,.16); }
    .service-gutter i { position: absolute; left: 20px; right: 46px; top: 7px; height: 5px; border-radius: 999px; background: linear-gradient(90deg, var(--rain-blue), #76b6c9); }
    .service-downspout { position: absolute; right: 54px; top: 194px; width: 22px; height: 74px; background: linear-gradient(90deg, #e5e9e8, var(--aluminum-dark)); border: 1px solid #7f8b91; border-radius: 0 0 10px 10px; }
    .service-tools { position: absolute; left: 26px; bottom: 18px; display: flex; gap: 10px; align-items: center; }
    .service-tools span, .service-tools b { padding: 8px 10px; border-radius: 999px; background: rgba(255,255,255,.9); color: var(--ink-2); font-size: .82rem; box-shadow: var(--shadow-soft); }
    .visual-metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .service-content-grid { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 28px; align-items: start; }
    .service-copy { padding: clamp(28px, 4vw, 48px); }
    .service-copy p { font-size: 1.12rem; line-height: 1.72; }
    .service-copy .opening-paragraph { color: var(--ink-2); font-size: 1.24rem; }
    .trade-quote-card { position: sticky; top: 96px; padding: 26px; border-radius: 18px; background: #fff; border: 1px solid #ded5c6; box-shadow: rgba(31, 42, 50, .08) 0 18px 38px; }
    .trade-quote-card h2 { font-size: 2rem; }
    .trade-quote-card .btn { margin-top: 26px; width: 100%; }
    @media (max-width: 960px) { .service-hero-grid, .service-content-grid { grid-template-columns: 1fr; } .trade-quote-card { position: relative; top: 0; } }
    @media (max-width: 560px) { .visual-metrics { grid-template-columns: 1fr; } }
  </style>
</BaseLayout>

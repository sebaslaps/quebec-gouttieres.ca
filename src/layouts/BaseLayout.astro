---
import site from '../data/site.json';

const {
  title = site.title,
  description = site.metaDescription,
  canonicalPath = '/',
} = Astro.props;
const canonicalUrl = new URL(canonicalPath, `https://${site.domain}`).toString();
---
<!doctype html>
<html lang="fr-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:locale" content="fr_CA" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Québec Gouttières" />
    <meta name="twitter:card" content="summary_large_image" />
    <style is:global>
      :root {
        color-scheme: light;
        --roof-charcoal: #1f2a32;
        --roof-deep: #121a20;
        --aluminum: #d7dee2;
        --aluminum-dark: #8f9ca3;
        --cedar: #5f4a33;
        --safety-orange: #f97316;
        --safety-orange-dark: #c2410c;
        --rain-blue: #2f80a7;
        --evergreen: #2f5d50;
        --cream: #f7f1e7;
        --ink: var(--roof-deep);
        --ink-2: #334149;
        --muted: #56656d;
        --muted-2: #7f8c93;
        --brand: var(--safety-orange);
        --brand-hover: var(--safety-orange-dark);
        --brand-dark: var(--roof-charcoal);
        --teal: var(--evergreen);
        --teal-bright: #6fa391;
        --ice: #edf5f7;
        --white: #ffffff;
        --surface: #faf7f0;
        --surface-glass: rgba(255, 252, 245, 0.78);
        --line: #e5ded2;
        --line-strong: #cfc6b7;
        --ruby: #b53b2f;
        --success: #2f7a4f;
        --gradient-aurora: radial-gradient(circle at 14% 16%, rgba(249, 115, 22, 0.18), transparent 27%), radial-gradient(circle at 86% 12%, rgba(47, 93, 80, 0.18), transparent 28%), radial-gradient(circle at 70% 82%, rgba(143, 156, 163, 0.18), transparent 30%), linear-gradient(135deg, #fbf7ef 0%, #ffffff 45%, #edf4f2 100%);
        --gradient-dark: radial-gradient(circle at 12% 5%, rgba(249, 115, 22, 0.22), transparent 25%), radial-gradient(circle at 82% 20%, rgba(111, 163, 145, 0.20), transparent 24%), linear-gradient(135deg, #121a20 0%, #1f2a32 54%, #2f5d50 100%);
        --shadow-premium: rgba(50, 50, 93, 0.25) 0px 30px 45px -30px, rgba(0, 0, 0, 0.10) 0px 18px 36px -18px;
        --shadow-soft: rgba(23, 23, 23, 0.08) 0px 15px 35px 0px;
        --font-sans: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        color: var(--ink);
        background: var(--white);
        font-family: var(--font-sans);
        font-feature-settings: "ss01";
        line-height: 1.55;
        overflow-x: hidden;
      }
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: -2;
        background: var(--gradient-aurora);
      }
      a { color: inherit; }
      .container { width: min(1160px, calc(100% - 36px)); margin: 0 auto; }
      .container.narrow { width: min(920px, calc(100% - 36px)); }
      .noise-overlay {
        position: fixed;
        inset: 0;
        pointer-events: none;
        opacity: .035;
        z-index: -1;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      }
      .topbar {
        color: rgba(255,255,255,.88);
        background: var(--roof-deep);
        font-size: .92rem;
        letter-spacing: .01em;
      }
      .topbar .container { display: flex; justify-content: space-between; gap: 16px; padding: 8px 0; flex-wrap: wrap; }
      .topbar a { color: white; text-decoration: none; font-weight: 700; }
      header.site-header {
        position: sticky;
        top: 0;
        z-index: 20;
        border-bottom: 1px solid rgba(229,237,245,.72);
        background: rgba(255,255,255,.76);
        backdrop-filter: blur(22px) saturate(1.4);
      }
      .nav { display: flex; align-items: center; justify-content: space-between; gap: 22px; padding: 14px 0; }
      .logo { display: inline-flex; align-items: center; gap: 10px; font-weight: 800; color: var(--ink); text-decoration: none; letter-spacing: -.015em; }
      .logo-mark {
        width: 38px; height: 38px; display: grid; place-items: center;
        border-radius: 10px;
        color: white;
        background: linear-gradient(135deg, var(--safety-orange), var(--roof-charcoal));
        box-shadow: var(--shadow-premium);
        font-family: var(--font-mono);
        font-size: .88rem;
      }
      nav ul { display: flex; align-items: center; gap: 6px; list-style: none; margin: 0; padding: 0; flex-wrap: wrap; }
      nav a:not(.btn) {
        display: inline-flex;
        padding: 9px 12px;
        border-radius: 8px;
        color: var(--ink-2);
        font-weight: 700;
        font-size: .95rem;
        text-decoration: none;
        transition: background .18s ease, color .18s ease, transform .18s ease;
      }
      nav a:not(.btn):hover { background: rgba(249,115,22,.10); color: var(--brand); transform: translateY(-1px); }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 11px 17px;
        border: 1px solid transparent;
        border-radius: 8px;
        background: var(--brand);
        color: white;
        font-weight: 800;
        text-decoration: none;
        line-height: 1;
        box-shadow: rgba(249,115,22,.28) 0 16px 30px -14px;
        transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
      }
      .btn:hover { transform: translateY(-2px); background: var(--brand-hover); box-shadow: rgba(249,115,22,.36) 0 22px 36px -16px; }
      .btn.secondary { background: white; color: var(--roof-charcoal); border-color: #d8c9b6; box-shadow: none; }
      .btn.dark { background: var(--roof-deep); color: white; }
      main { overflow: hidden; }
      section { padding: clamp(70px, 9vw, 118px) 0; position: relative; }
      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--brand);
        text-transform: uppercase;
        letter-spacing: .15em;
        font-family: var(--font-mono);
        font-size: .76rem;
        font-weight: 700;
        margin: 0 0 18px;
      }
      .eyebrow::before { content: ""; width: 8px; height: 8px; border-radius: 3px; background: linear-gradient(135deg, var(--brand), var(--teal-bright)); }
      h1, h2, h3 { color: var(--ink); margin: 0 0 18px; line-height: 1.02; letter-spacing: -.045em; }
      h1 { font-size: clamp(2.95rem, 6.8vw, 5.85rem); font-weight: 700; max-width: 980px; }
      h2 { font-size: clamp(2.25rem, 5vw, 4.35rem); font-weight: 700; max-width: 820px; }
      h3 { font-size: clamp(1.35rem, 2.4vw, 1.85rem); font-weight: 700; letter-spacing: -.025em; }
      p { margin: 0 0 18px; color: var(--muted); font-size: 1.05rem; }
      .lead { font-size: clamp(1.15rem, 2.2vw, 1.45rem); line-height: 1.42; color: #3d526c; max-width: 760px; }
      .grid { display: grid; gap: 24px; }
      .two { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: center; }
      .three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .card, .plain-card {
        position: relative;
        border: 1px solid rgba(229,237,245,.94);
        border-radius: 18px;
        background: var(--surface-glass);
        box-shadow: var(--shadow-premium);
        backdrop-filter: blur(18px) saturate(1.2);
      }
      .card { padding: clamp(24px, 3.5vw, 36px); }
      .plain-card { padding: clamp(24px, 3.5vw, 34px); background: rgba(246,249,252,.82); }
      .feature-list { margin: 22px 0 0; padding: 0; list-style: none; display: grid; gap: 13px; }
      .feature-list li { position: relative; padding-left: 32px; color: var(--ink-2); font-size: 1.03rem; }
      .feature-list li::before {
        content: "✓";
        position: absolute;
        left: 0; top: 0;
        width: 21px; height: 21px;
        display: grid; place-items: center;
        border-radius: 7px;
        color: white;
        background: linear-gradient(135deg, var(--teal), var(--teal-bright));
        font-size: .8rem;
        font-weight: 900;
      }
      .service-link { display: inline-flex; gap: 8px; margin-top: 16px; color: var(--brand); font-weight: 900; text-decoration: none; }
      .dark {
        color: white;
        background: var(--gradient-dark);
      }
      .dark h1, .dark h2, .dark h3 { color: white; }
      .dark p, .dark li { color: rgba(255,255,255,.76); }
      .dark .eyebrow { color: #fbbf8a; }
      .cta-band {
        overflow: hidden;
        position: relative;
        display: grid;
        grid-template-columns: 1.35fr auto;
        align-items: center;
        gap: 24px;
        padding: clamp(30px, 5vw, 58px);
        border-radius: 18px;
        color: white;
        background: var(--gradient-dark);
        box-shadow: var(--shadow-premium);
      }
      .cta-band::after { content: ""; position: absolute; inset: auto -12% -42% 50%; height: 220px; background: radial-gradient(circle, rgba(249,115,22,.30), transparent 62%); }
      .cta-band h2, .cta-band h3 { color: white; }
      .cta-band p { color: rgba(255,255,255,.78); }
      .footer {
        padding: 56px 0 38px;
        color: #dfefff;
        background: var(--roof-deep);
      }
      .footer .logo { color: white; }
      .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 34px; }
      .footer p, .footer a { color: rgba(223,239,255,.76); }
      .footer a { text-decoration: none; }
      .footer h3 { color: white; font-size: 1.1rem; letter-spacing: -.01em; }
      .marquee-track {
        margin-top: 38px;
        padding-top: 18px;
        border-top: 1px solid rgba(255,255,255,.14);
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        color: rgba(223,239,255,.58);
        font-family: var(--font-mono);
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .08em;
      }
      @media (max-width: 900px) {
        .two, .three, .footer-grid, .cta-band { grid-template-columns: 1fr; }
        .nav { align-items: flex-start; flex-direction: column; }
        nav ul { align-items: flex-start; }
        h1 { font-size: clamp(2.75rem, 14vw, 4.2rem); }
      }
    </style>
  </head>
  <body>
    <div class="noise-overlay" aria-hidden="true"></div>
    <div class="topbar">
      <div class="container">
        <span>Gouttières sans joints, nettoyage et pare-feuilles dans la grande région de Québec</span>
        <a href="mailto:info@quebec-gouttieres.ca">Soumission gratuite : {site.email}</a>
      </div>
    </div>
    <header class="site-header">
      <div class="container nav">
        <a class="logo" href="/" aria-label="Accueil Québec Gouttières"><span class="logo-mark">QG</span><span>Québec Gouttières</span></a>
        <nav aria-label="Navigation principale">
          <ul>
            <li><a href="/#services">Services</a></li>
            <li><a href="/installation-gouttieres-sans-joints/">Installation</a></li>
            <li><a href="/nettoyage-gouttieres/">Nettoyage</a></li>
            <li><a href="/pare-feuilles/">Pare-feuilles</a></li>
            <li><a class="btn" href="mailto:info@quebec-gouttieres.ca?subject=Soumission gratuite - gouttières">Soumission gratuite</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="footer">
      <div class="container footer-grid">
        <div>
          <a class="logo" href="/"><span class="logo-mark">QG</span><span>Québec Gouttières</span></a>
          <p>Une présence locale spécialisée pour propriétaires qui veulent protéger leur maison contre l’eau, la neige, la glace et le gel-dégel dans la région de Québec.</p>
        </div>
        <div>
          <h3>Services</h3>
          <p><a href="/installation-gouttieres-sans-joints/">Installation de gouttières sans joints</a></p>
          <p><a href="/nettoyage-gouttieres/">Nettoyage de gouttières</a></p>
          <p><a href="/pare-feuilles/">Pare-feuilles</a></p>
        </div>
        <div>
          <h3>Contact</h3>
          <p><a href="mailto:info@quebec-gouttieres.ca">{site.email}</a></p>
          <p>Soumission gratuite pour la région de Québec.</p>
        </div>
      </div>
      <div class="container marquee-track" aria-label="Mots-clés services">
        <span>Québec</span><span>Lévis</span><span>Sainte-Foy</span><span>Beauport</span><span>Charlesbourg</span><span>Rive-Sud</span>
      </div>
    </footer>
  </body>
</html>
